# Для запуска на компьютере скопируй в .env. На Render значения вводятся в Environment.
BOT_TOKEN=сюда_токен_от_BotFather
# Telegram ID (узнай командой /id у бота). Несколько — через запятую: 111,222
OWNER_CHAT_ID=
# Строка подключения к Neon (чтобы записи пробежек и подписчики не пропадали)
DATABASE_URL=
TIMEZONE=Asia/Bishkek
MORNING_TIME=05:00
LUNCH_TIME=13:00
